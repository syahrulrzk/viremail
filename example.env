# VIRE — environment template
# Copy this file to `.env` and adjust the values for your setup:
#   cp example.env .env

# ---- Database (PostgreSQL) ----
POSTGRES_SERVER=localhost
POSTGRES_USER=osintmail
POSTGRES_PASSWORD=osintmail123
POSTGRES_DB=osintmail
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Security (CHANGE THIS in production!) ----
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Optional GitHub token (raises commit-search rate limits) ----
# GITHUB_TOKEN=

# ---- Feature toggles ----
# SMTP verification (default OFF — scan collects emails found on the
# internet as references; active/inactive check slows the scan)
# SMTP_VERIFY_ENABLED=false
# OCR_ENABLED=true
# DEEP_TOOLS_ENABLED=true

# ---- Production (docker-compose.prod.yml) ----
# GITHUB_REPOSITORY=your-org/vire
# IMAGE_TAG=latest
# WORKER_REPLICAS=3
# NEXT_PUBLIC_API_URL=http://localhost:8000
